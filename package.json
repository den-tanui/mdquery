{
  "name": "@den-tanui/mdquery",
  "version": "0.2.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mdquery": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run build:lib && bun run build:cli",
    "build:lib": "bun build src/index.ts --outdir dist --target node",
    "build:cli": "bun build src/cli.ts --compile --outfile bin/mdquery",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false src/ tests/",
    "dead-code": "knip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "csv-stringify": "^6.8.3",
    "fdir": "6.5.0",
    "gray-matter": "^4.0.3",
    "grepts": "0.0.1",
    "ignore": "^7.0.6",
    "js-yaml": "^5.3.0",
    "mdast": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^8.2.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^1.0.0",
    "knip": "^6.32.2",
    "typescript": "^5.5.0",
    "vitest": "^1.0.0"
  }
}
